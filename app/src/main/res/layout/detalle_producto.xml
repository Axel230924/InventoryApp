<?xml version="1.0" encoding="utf-8"?>

<!-- Contenedor principal de la pantalla Detalle de producto. ConstraintLayout permite organizar los elementos mediante restricciones -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    tools:context=".ui.productos.DetalleProductoActivity">

    <!-- Título principal de la pantalla.-->
    <androidx.cardview.widget.CardView
        android:id="@+id/barraSuperior"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Contenedor horizontal de la barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#022D36">

            <!--BOTÓN DE MENÚ: Las tres líneas permitirán abrir posteriormente el menú lateral de navegación. -->
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textSize="28sp"
                android:textColor="#FFFFFF"/>

            <!--TÍTULO: Indica que estamos en la pantalla de detalle del producto. -->
            <TextView
                android:id="@+id/tvTituloDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle del producto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- TARJETA PRINCIPAL: Contiene toda la información del producto -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProducto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="30dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="#FFFFFF">

        <!-- Contenedor vertical de toda la información del producto.-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <!--IMAGEN DEL PRODUCTO: Representa visualmente el producto. Por ahora utilizamos un recurso drawable. -->
            <ImageView
                android:id="@+id/imgProducto"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Imagen del producto"
                android:scaleType="fitCenter"
                android:src="@drawable/laptop" />

            <!--CONTENEDOR DEL NOMBRE Y ESTADO: Permite colocar el nombre a la izquierda y el estado del producto a la derecha. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Nombre del producto -->
                <TextView
                    android:id="@+id/tvNombreProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Laptop del inspiro 15"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <!-- Estado del producto -->
                <TextView
                    android:id="@+id/tvEstadoProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_estado"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Activo"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#5ccb5f"/>

            </LinearLayout>


            <!-- INFORMACIÓN DEL PRODUCTO: Cada fila contiene el nombre del dato y su respectivo valor. -->
            <!-- Código -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Código:"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvCodigoProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAP001"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

            </LinearLayout>


            <!-- Categoría -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Categoría"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvCategoriaProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="computadora"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

            </LinearLayout>


            <!-- Precio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Precio:"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvPrecioProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$550.00"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

            </LinearLayout>


            <!-- Stock actual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stock Actual:"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvStockActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 unidades"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

            </LinearLayout>


            <!-- Stock mínimo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stock mínimo"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/tvStockMinimo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 unidades"
                    android:textSize="14sp"
                    android:textColor="#000000"/>

            </LinearLayout>


            <!--TÍTULO DE LA DESCRIPCIÓN: Aparece fuera del cuadro de descripción. -->
            <TextView
                android:id="@+id/tvTituloDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Descripción:"
                android:textSize="14sp"
                android:textColor="#000000"/>


            <!--CUADRO DE DESCRIPCIÓN: Contiene las características adicionales del producto. -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDescripcion"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="22dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <!-- Texto de la descripción -->
                <TextView
                    android:id="@+id/tvDescripcionProducto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:text="8GB de ram"
                    android:textSize="14sp"
                    android:textColor="#000000" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>